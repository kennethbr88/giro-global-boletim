# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA suba o arquivo ".env" (com valores reais) para um repositório público.

# Chave da API da Anthropic — gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Token do seu bot do Telegram — gere falando com @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExemploDoToken

# Seu chat_id — descubra rodando: python get_chat_id.py SEU_TOKEN
TELEGRAM_CHAT_ID=123456789
